<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>LobbyLocker</vendor>
  <vendor_url>https://github.com/its4lion/lobbylocker</vendor_url>
  <icon_name>lobbylocker</icon_name>
  <action id="org.lobbylocker.firewall.modifier">
    <description>Run LobbyLocker firewall changes</description>
    <message>Authentication is required to modify firewall rules</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/lobbylocker</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--firewall-helper</annotate>
  </action>
</policyconfig>