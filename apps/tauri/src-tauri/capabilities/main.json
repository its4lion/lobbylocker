{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local LobbyLocker main window. No shell, filesystem, or remote-content permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-min-size",
    "core:window:allow-set-size",
    "process:default",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/its4lion" },
        { "url": "https://x.com/its4lion" }
      ]
    }
  ]
}
